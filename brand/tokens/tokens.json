{
  "name": "kanso",
  "version": "3.0.0",
  "tagline": { "primary": "Keep it kanso.", "secondary": "Ctrl + Zen" },
  "color": {
    "light": {
      "paper": "#F4EFE4",
      "surface": "#FBF8F1",
      "surfaceRaised": "#FFFDF8",
      "border": "#E3DCCD",
      "borderStrong": "#CFC6B4",
      "ink": "#191817",
      "textSecondary": "#4A4640",
      "textMuted": "#6B655C",
      "pencil": "#8A847A",
      "rule": "#D6DEE3",
      "keyRed": "#C8402F",
      "keySide": "#8E2A1F",
      "keyDeep": "#A33224"
    },
    "dark": {
      "paper": "#191817",
      "surface": "#24221F",
      "surfaceRaised": "#2C2A26",
      "ink": "#EDE6D6",
      "textSecondary": "#CFC7B8",
      "textMuted": "#B5AEA2",
      "keyRed": "#D4533F",
      "keySide": "#9E3426"
    },
    "status": {
      "done":     { "name": "Leaf",          "base": "#7FB069", "subtle": "#E4F0DC", "text": "#2F5A22", "meaning": "Completed" },
      "upcoming": { "name": "Highlighter",   "base": "#E6B422", "subtle": "#FAEFC8", "text": "#5C4300", "meaning": "Due in a few days" },
      "due":      { "name": "Marker orange", "base": "#E0813A", "subtle": "#FBE1CE", "text": "#7A3510", "meaning": "Due today or tomorrow" },
      "slipped":  { "name": "Slipped",       "base": "#D9A441", "subtle": "#ECE7DD", "text": "#4A4640", "meaning": "Overdue, shown gently as a pencil chip with an amber dot" }
    }
  },
  "typography": {
    "display": { "family": "Fraunces", "axes": { "SOFT": 100, "WONK": 0, "opsz": "auto" }, "weights": [300, 400, 500], "use": "Wordmark, display, H1, H2" },
    "sans": { "family": "M PLUS Rounded 1c", "weights": [400, 500, 700], "use": "Body, UI, labels, H3" },
    "scale": {
      "display": { "font": "display", "size": 64, "lineHeight": 72, "weight": 400 },
      "h1":      { "font": "display", "size": 40, "lineHeight": 48, "weight": 500 },
      "h2":      { "font": "display", "size": 28, "lineHeight": 36, "weight": 500 },
      "h3":      { "font": "sans",    "size": 18, "lineHeight": 26, "weight": 700 },
      "body":    { "font": "sans",    "size": 16, "lineHeight": 26, "weight": 400 },
      "small":   { "font": "sans",    "size": 13, "lineHeight": 20, "weight": 500 }
    }
  },
  "radius": { "small": 4, "buttons": 8, "cards": 12, "pills": 999 },
  "logo": {
    "mark": "logo/kanso-mark.svg",
    "markDark": "logo/kanso-mark-dark.svg",
    "markInk": "logo/kanso-mark-ink.svg",
    "markPressed": "logo/kanso-mark-pressed.svg",
    "markFlat": "logo/kanso-mark-flat.svg",
    "lockupHorizontal": "logo/kanso-lockup-horizontal.svg",
    "lockupHorizontalDark": "logo/kanso-lockup-horizontal-dark.svg",
    "lockupStacked": "logo/kanso-lockup-stacked.svg",
    "lockupStackedDark": "logo/kanso-lockup-stacked-dark.svg",
    "wordmark": "logo/kanso-wordmark.svg",
    "wordmarkLight": "logo/kanso-wordmark-light.svg"
  }
}
